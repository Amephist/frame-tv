[Unit]
Description=frame-tv (arte en la Samsung Frame) en :8700
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/Projects/frame-tv
EnvironmentFile=%h/.config/frame-tv/env
ExecStart=%h/Projects/frame-tv/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8700
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
